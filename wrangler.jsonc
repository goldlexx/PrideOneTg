// PRIDE ONE Booking Bot РІР‚вЂќ Р С”Р С•Р Р…РЎвЂћР С‘Р С–РЎС“РЎР‚Р В°РЎвЂ Р С‘РЎРЏ Cloudflare Workers (РЎвЂљР В°РЎР‚Р С‘РЎвЂћ Workers Free).
// Р СџР ВµРЎР‚Р ВµР Т‘ Р С—Р ВµРЎР‚Р Р†Р С•Р в„– Р С—РЎС“Р В±Р В»Р С‘Р С”Р В°РЎвЂ Р С‘Р ВµР в„– Р В·Р В°Р СР ВµР Р…Р С‘РЎвЂљР Вµ Р Т‘Р Р†Р В° Р В·Р Р…Р В°РЎвЂЎР ВµР Р…Р С‘РЎРЏ, Р С—Р С•Р СР ВµРЎвЂЎР ВµР Р…Р Р…РЎвЂ№Р Вµ Р’В«Р вЂ™Р РЋР СћР С’Р вЂ™Р В¬Р СћР вЂўР’В» (FIRST_RUN.md, РЎв‚¬Р В°Р С– 6).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pride-one-bot",
  "main": "src/index.js",
  "keep_vars": true,
  // RPC Р С” Durable Objects РЎвЂљРЎР‚Р ВµР В±РЎС“Р ВµРЎвЂљ Р Т‘Р В°РЎвЂљРЎвЂ№ РЎРѓР С•Р Р†Р СР ВµРЎРѓРЎвЂљР С‘Р СР С•РЎРѓРЎвЂљР С‘ Р Р…Р Вµ РЎР‚Р В°Р Р…РЎРЉРЎв‚¬Р Вµ 2024-04-03.
  "compatibility_date": "2025-10-01",
  // Р РЋР С•РЎвЂ¦РЎР‚Р В°Р Р…РЎРЏР ВµРЎвЂљ Р В°Р Т‘РЎР‚Р ВµРЎРѓ https://pride-one-bot.<Р Р†Р В°РЎв‚¬-Р С—Р С•Р Т‘Р Т‘Р С•Р СР ВµР Р…>.workers.dev, Р Р…Р В° Р С”Р С•РЎвЂљР С•РЎР‚РЎвЂ№Р в„– Р Р…Р В°РЎРѓРЎвЂљРЎР‚Р С•Р ВµР Р… webhook.
  "workers_dev": true,

  // Mini App: статические файлы из mini-app/dist раздаются тем же Worker (тот же домен, без CORS).
  // Пути, которых нет среди файлов (/api/*, /webhook, /admin/*, /health), попадают в код Worker.
  "assets": { "directory": "./mini-app/dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Durable Object РЎвЂћР С‘Р В»Р С‘Р В°Р В»Р В°: Р С•Р Т‘Р С‘Р Р… Р С•Р В±РЎР‰Р ВµР С”РЎвЂљ Р Р…Р В° РЎвЂћР С‘Р В»Р С‘Р В°Р В», Р Т‘Р В°Р Р…Р Р…РЎвЂ№Р Вµ РІР‚вЂќ Р Р†Р С• Р Р†РЎРѓРЎвЂљРЎР‚Р С•Р ВµР Р…Р Р…Р С•Р С SQLite.
  "durable_objects": {
    "bindings": [
      { "name": "BRANCH_DO", "class_name": "BranchBookingDO" }
    ]
  },

  // Р С›Р Т‘Р Р…Р С•Р С”РЎР‚Р В°РЎвЂљР Р…Р В°РЎРЏ Р СР С‘Р С–РЎР‚Р В°РЎвЂ Р С‘РЎРЏ, РЎРѓР С•Р В·Р Т‘Р В°РЎР‹РЎвЂ°Р В°РЎРЏ Р С”Р В»Р В°РЎРѓРЎРѓ Durable Object РЎРѓ РЎвЂ¦РЎР‚Р В°Р Р…Р С‘Р В»Р С‘РЎвЂ°Р ВµР С SQLite.
  // Р СњР В° РЎвЂљР В°РЎР‚Р С‘РЎвЂћР Вµ Workers Free Р Т‘Р С•РЎРѓРЎвЂљРЎС“Р С—Р Р…РЎвЂ№ РЎвЂљР С•Р В»РЎРЉР С”Р С• SQLite-Р С•Р В±РЎР‰Р ВµР С”РЎвЂљРЎвЂ№ (new_sqlite_classes).
  // Р В­РЎвЂљРЎС“ Р В·Р В°Р С—Р С‘РЎРѓРЎРЉ Р Р…Р ВµР В»РЎРЉР В·РЎРЏ Р СР ВµР Р…РЎРЏРЎвЂљРЎРЉ Р С‘Р В»Р С‘ РЎС“Р Т‘Р В°Р В»РЎРЏРЎвЂљРЎРЉ Р С—Р С•РЎРѓР В»Р Вµ Р С—РЎС“Р В±Р В»Р С‘Р С”Р В°РЎвЂ Р С‘Р С‘; Р В±РЎС“Р Т‘РЎС“РЎвЂ°Р С‘Р Вµ Р С‘Р В·Р СР ВµР Р…Р ВµР Р…Р С‘РЎРЏ РІР‚вЂќ Р Р…Р С•Р Р†РЎвЂ№Р СР С‘ РЎвЂљР ВµР С–Р В°Р СР С‘.
  // Р СџР С•РЎРѓР В»Р Вµ РЎР‚Р В°Р В·Р Р†РЎвЂРЎР‚РЎвЂљРЎвЂ№Р Р†Р В°Р Р…Р С‘РЎРЏ РЎРЊРЎвЂљР С•Р в„– Р СР С‘Р С–РЎР‚Р В°РЎвЂ Р С‘Р С‘ Р С•РЎвЂљР С”Р В°РЎвЂљ Р Р…Р В° Р Р†Р ВµРЎР‚РЎРѓР С‘Р С‘ Worker Р Т‘Р С• Р Р…Р ВµРЎвЂ Р Р…Р ВµР Р†Р С•Р В·Р СР С•Р В¶Р ВµР Р… (РЎРѓР С. FIRST_RUN.md).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BranchBookingDO"] }
  ],

  // Р РЋРЎвЂљР В°РЎР‚Р С•Р Вµ РЎвЂ¦РЎР‚Р В°Р Р…Р С‘Р В»Р С‘РЎвЂ°Р Вµ KV: РЎвЂљР С•Р В»РЎРЉР С”Р С• РЎвЂЎРЎвЂљР ВµР Р…Р С‘Р Вµ Р С—РЎР‚Р С‘ Р СР С‘Р С–РЎР‚Р В°РЎвЂ Р С‘Р С‘, Р Т‘Р В°Р Р…Р Р…РЎвЂ№Р Вµ Р Р…Р Вµ Р С‘Р В·Р СР ВµР Р…РЎРЏРЎР‹РЎвЂљРЎРѓРЎРЏ.
  // ID: `npx wrangler kv namespace list` РІвЂ вЂ™ PRIDE_ONE_DEMO (FIRST_RUN.md, РЎв‚¬Р В°Р С– 4).
  "kv_namespaces": [
    { "binding": "PRIDE_KV", "id": "aa81647197b7485c9f249663076fee54" }
  ],

  // Р С™Р В°Р С”Р В°РЎРЏ Telegram-Р С–РЎР‚РЎС“Р С—Р С—Р В° Р С•Р В±РЎРѓР В»РЎС“Р В¶Р С‘Р Р†Р В°Р ВµРЎвЂљ Р С”Р В°Р С”Р С•Р в„– РЎвЂћР С‘Р В»Р С‘Р В°Р В» (FIRST_RUN.md, РЎв‚¬Р В°Р С– 5).
  // Р СџР С•Р С”Р В° Р В·Р Т‘Р ВµРЎРѓРЎРЉ Р В·Р В°Р С–Р В»РЎС“РЎв‚¬Р С”Р В°, `npm run check` Р Р…Р Вµ Р С—РЎР‚Р С•Р С—РЎС“РЎРѓРЎвЂљР С‘РЎвЂљ Р С—РЎС“Р В±Р В»Р С‘Р С”Р В°РЎвЂ Р С‘РЎР‹.
  "vars": {

  },

  // Р вЂўР В¶Р ВµРЎвЂЎР В°РЎРѓР Р…Р С• Р В±РЎС“Р Т‘Р С‘РЎвЂљ Р С•Р В±РЎР‰Р ВµР С”РЎвЂљ РЎвЂћР С‘Р В»Р С‘Р В°Р В»Р В°: Р С—Р В°Р Р…Р ВµР В»РЎРЉ РЎС“Р В±Р С‘РЎР‚Р В°Р ВµРЎвЂљ Р С—РЎР‚Р С•РЎв‚¬Р ВµР Т‘РЎв‚¬Р С‘Р Вµ Р В·Р В°Р Р…РЎРЏРЎвЂљР С‘РЎРЏ Р Т‘Р В°Р В¶Р Вµ Р В±Р ВµР В· Р В°Р С”РЎвЂљР С‘Р Р†Р Р…Р С•РЎРѓРЎвЂљР С‘ Р Р† Р С–РЎР‚РЎС“Р С—Р С—Р Вµ.
  "triggers": { "crons": ["0 * * * *"] }

  // Р РЋР ВµР С”РЎР‚Р ВµРЎвЂљРЎвЂ№ Р В·Р В°Р Т‘Р В°РЎР‹РЎвЂљРЎРѓРЎРЏ Р Р…Р Вµ Р В·Р Т‘Р ВµРЎРѓРЎРЉ. Р СџР С•РЎР‚РЎРЏР Т‘Р С•Р С” Р С—Р ВµРЎР‚Р Р†Р С•Р С–Р С• РЎР‚Р В°Р В·Р Р†РЎвЂРЎР‚РЎвЂљРЎвЂ№Р Р†Р В°Р Р…Р С‘РЎРЏ РІР‚вЂќ FIRST_RUN.md:
  //   BOT_TOKEN, WEBHOOK_SECRET РІР‚вЂќ РЎС“Р В¶Р Вµ Р ВµРЎРѓРЎвЂљРЎРЉ РЎС“ РЎвЂљР ВµР С”РЎС“РЎвЂ°Р ВµР С–Р С• Worker Р С‘ РЎРѓР С•РЎвЂ¦РЎР‚Р В°Р Р…РЎРЏРЎР‹РЎвЂљРЎРѓРЎРЏ;
  //   ADMIN_SECRET РІР‚вЂќ Р Р…Р С•Р Р†РЎвЂ№Р в„–, Р В·Р В°Р С–РЎР‚РЎС“Р В¶Р В°Р ВµРЎвЂљРЎРѓРЎРЏ Р Р†Р СР ВµРЎРѓРЎвЂљР Вµ РЎРѓ Р С”Р С•Р Т‘Р С•Р С:
  //     npx wrangler deploy --secrets-file .secrets.deploy.env
